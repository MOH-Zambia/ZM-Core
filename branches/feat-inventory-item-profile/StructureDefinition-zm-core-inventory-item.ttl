       fhir:id [ fhir:v "InventoryItem.characteristic.value[x]" ] ;
       fhir:path [ fhir:v "InventoryItem.characteristic.value[x]" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "InventoryItem.instance" ] ;
       fhir:path [ fhir:v "InventoryItem.instance" ] ;
       fhir:short [ fhir:v "Not used: a lot, serial number or expiry belongs to stock, not to the catalogue" ] ;
       fhir:max [ fhir:v "0" ]
     ] )
  ] . # 

